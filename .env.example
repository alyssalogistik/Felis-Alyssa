# Salin file ini jadi .env, lalu isi dari:
# Supabase Dashboard -> Project Settings -> API

# URL project. Bentuknya https://<project-ref>.supabase.co
SUPABASE_URL=

# Kunci publik. Aman dipakai di browser (dilindungi Row Level Security).
SUPABASE_ANON_KEY=

# Kunci admin. MENEMBUS Row Level Security.
# HANYA untuk server / env var Railway. Jangan pernah masuk ke kode frontend.
# Boleh dikosongkan kalau belum butuh akses admin.
SUPABASE_SERVICE_ROLE_KEY=

# Project ref yang BOLEH disentuh, yaitu bagian <ref> dari SUPABASE_URL.
# Kalau diisi, aplikasi menolak menyala ketika kredensial menunjuk ke project
# lain. Ini yang menjaga Alyssa Logistics tidak pernah menulis ke database
# project lain, termasuk milik pihak lain.
SUPABASE_PROJECT_REF=
